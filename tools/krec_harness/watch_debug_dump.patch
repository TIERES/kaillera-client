+#define N02_WATCH_DEBUG_DIR ".\\records\\watch_debug"
+
+void n02_watch_debug_dump(const char* role, const char* sessionId, int frameIndex, int byteOffset, const void* data, int size) {
+	DWORD attr = GetFileAttributesA(N02_WATCH_DEBUG_DIR);
+	if (attr == INVALID_FILE_ATTRIBUTES || !(attr & FILE_ATTRIBUTE_DIRECTORY) || data == NULL || size <= 0)
+		return;
+
+	char path[MAX_PATH];
+	_snprintf(path, sizeof(path), N02_WATCH_DEBUG_DIR "\\%s_%s_f%d_o%d.state", role, sessionId, frameIndex, byteOffset);
+	path[sizeof(path) - 1] = 0;
+	FILE* f = fopen(path, "wb");
+	if (f != NULL) {
+		fwrite(data, 1, size, f);
+		fclose(f);
+	}
+
+	FILE* log = fopen(N02_WATCH_DEBUG_DIR "\\watch_debug.txt", "a");
+	if (log != NULL) {
+		SYSTEMTIME st;
+		GetLocalTime(&st);
+		fprintf(log, "%04d-%02d-%02d %02d:%02d:%02d %s session=%s frame=%d offset=%d size=%d\n",
+			st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond,
+			role, sessionId, frameIndex, byteOffset, size);
+		fclose(log);
+	}
+}
