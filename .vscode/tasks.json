{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (x64 Release)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build (x86 Release)",
            "type": "shell",
            "command": "${workspaceFolder}\\build-x86.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Publish release to updater",
            "detail": "Publishes a GitHub release (DLL-only update) plus the last light zip empacotar.ps1 generated (full RetroArch TIERES package: only the files the site doesn't have yet) - see deploy/publish_release.sh",
            "type": "shell",
            "command": "bash deploy/publish_release.sh ${input:releaseTag}",
            "options": {
                "shell": {
                    "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                    "args": ["-l", "-c"]
                }
            },
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Publish release to updater (simular)",
            "detail": "Same checks and comparison with the site as the task above, but uploads nothing",
            "type": "shell",
            "command": "bash deploy/publish_release.sh ${input:releaseTag} --simular",
            "options": {
                "shell": {
                    "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                    "args": ["-l", "-c"]
                }
            },
            "group": "none",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "releaseTag",
            "type": "promptString",
            "description": "Release tag to publish (e.g. v.TIERES.0.15) - leave empty for the latest release"
        }
    ]
}
